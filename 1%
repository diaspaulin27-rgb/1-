  <script>
    (() => {
      "use strict";
      const canvas = document.querySelector("#game");
      const ctx = canvas.getContext("2d");
      const $ = (selector) => document.querySelector(selector);
      const clamp = (value, minimum, maximum) =>
        Math.max(minimum, Math.min(maximum, value));
      const rand = (minimum, maximum) =>
        minimum + Math.random() * (maximum - minimum);
      const storage = {
        get(key, fallback) {
          try {
            const value = localStorage.getItem("zanon1_" + key);
            return value === null
              ? fallback
              : JSON.parse(value);
          } catch {
            return fallback;
          }
        },
        set(key, value) {
          try {
            localStorage.setItem(
              "zanon1_" + key,
              JSON.stringify(value)
            );
          } catch {}
        }
      };
      let W = 0;
      let H = 0;
      let dpr = 1;
      let last = 0;
      let raf = 0;
      let mode = "menu";
      let soundOn = storage.get("sound", true);
      let score = 0;
      let best = storage.get("best", 0);
      let coins = storage.get("coins", 0);
      let targetX = 0;
      let pointerX = 0;
      let dragging = false;
      let shake = 0;
      let flash = 0;
      let nextCoin = 6;
      let nextBox = 15;
      let elapsed = 0;
      let controlsSign = 1;
      let modifiers = [];
      let objects = [];
      let particles = [];
      const skins = [
        {
          id: "classic",
          name: "Clássica",
          icon: "●",
          price: 0,
          color: "#111827"
        },
        {
          id: "fire",
          name: "Fogo",
          icon: "🔥",
          price: 30,
          color: "#ff5c35"
        },
        {
          id: "ice",
          name: "Gelo",
          icon: "❄️",
          price: 45,
          color: "#b9efff"
        },
        {
          id: "eight",
          name: "Bola 8",
          icon: "➑",
          price: 60,
          color: "#111"
        },
        {
          id: "angry",
          name: "Bravo",
          icon: "😡",
          price: 80,
          color: "#ef4444"
        },
        {
          id: "matte",
          name: "Preta Fosca",
          icon: "●",
          price: 0,
          color: "#020205",
          locked: true
        }
      ];
      let owned = storage.get("owned", ["classic"]);
      let selected = storage.get("skin", "classic");
      const activeSkin = () =>
        skins.find((skin) => skin.id === selected) || skins[0];
      const paddle = {
        x: 0,
        y: 0,
        w: 145,
        h: 24,
        baseW: 145
      };
      const ball = {
        x: 0,
        y: 0,
        r: 15,
        vx: 0,
        vy: 0,
        trail: []
      };
      const palettes = [
        ["#42b5ff", "#0868f7"],
        ["#1478ff", "#0636a9"],
        ["#082b78", "#1b164e"],
        ["#241356", "#7645ad"],
        ["#4c145f", "#160b2b"],
        ["#5e102c", "#160810"],
        ["#26030a", "#020205"]
      ];
      const rankNames = [
        "Azul Bebê",
        "Azul Royal",
        "Azul Marinho",
        "Lilás",
        "Roxo Meia-Noite",
        "Vermelho Sangue",
        "Modo Inferno"
      ];
      const paletteIndex = () =>
        score < 5
          ? 0
          : score < 11
          ? 1
          : score < 16
          ? 2
          : score < 21
          ? 3
          : score < 31
          ? 4
          : score < 41
          ? 5
          : 6;
      function resize() {
        dpr = Math.min(devicePixelRatio || 1, 2);
        W = innerWidth;
        H = innerHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width = W + "px";
        canvas.style.height = H + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        paddle.y = H - Math.max(88, 62);
        paddle.x = clamp(
          paddle.x || W / 2 - paddle.w / 2,
          8,
          W - paddle.w - 8
        );
        if (mode === "menu") {
          ball.x = W / 2;
          ball.y = H * 0.38;
        }
      }
      let audioCtx = null;
      function tone(
        frequency = 440,
        duration = 0.05,
        type = "sine",
        volume = 0.035
      ) {
        if (!soundOn) return;
        try {
          audioCtx ||=
            new (window.AudioContext ||
              window.webkitAudioContext)();
          const oscillator = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          oscillator.type = type;
          oscillator.frequency.value = frequency;
          gain.gain.setValueAtTime(
            volume,
            audioCtx.currentTime
          );
          gain.gain.exponentialRampToValueAtTime(
            0.0001,
            audioCtx.currentTime + duration
          );
          oscillator
            .connect(gain)
            .connect(audioCtx.destination);
          oscillator.start();
          oscillator.stop(audioCtx.currentTime + duration);
        } catch {}
      }
      function haptic(duration = 15) {
        if (navigator.vibrate) {
          navigator.vibrate(duration);
        }
      }
      function reset() {
        score = 0;
        elapsed = 0;
        nextCoin = rand(5, 8);
        nextBox = 15;
        objects = [];
        particles = [];
        modifiers = [];
        controlsSign = 1;
        shake = 0;
        flash = 0;
        paddle.baseW = clamp(W * 0.31, 112, 158);
        paddle.w = paddle.baseW;
        paddle.h = clamp(H * 0.025, 19, 25);
        paddle.x = W / 2 - paddle.w / 2;
        paddle.y = H - Math.max(86, H * 0.09);
        targetX = paddle.x;
        pointerX = W / 2;
        ball.r = clamp(W * 0.035, 12, 17);
        ball.x = W / 2;
        ball.y = H * 0.42;
        const speed = clamp(H * 0.48, 380, 520);
        ball.vx =
          speed * (Math.random() < 0.5 ? -0.42 : 0.42);
        ball.vy = speed * 0.9;
        ball.trail = [];
        updateHUD();
      }
      function startGame() {
        reset();
        mode = "playing";
        hideAll();
        last = performance.now();
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(loop);
      }
      function hideAll() {
        ["#start", "#gameOver", "#paused"].forEach(
          (selector) => {
            $(selector).classList.add("hidden");
          }
        );
      }
      function show(selector) {
        hideAll();
        $(selector).classList.remove("hidden");
      }
      function updateHUD() {
        $("#score").textContent =
          "SCORE " + String(score).padStart(4, "0");
        $("#difficulty").textContent = "+" + score + "%";
        $("#coinCount").textContent = coins;
      }
      function addScore(amount = 1) {
        score += amount;
        if (
          score >= 50 &&
          !owned.includes("matte")
        ) {
          owned.push("matte");
          storage.set("owned", owned);
          toast("SKIN PRETA FOSCA DESBLOQUEADA");
        }
        updateHUD();
        flash = 0.12;
      }
      function currentSpeedFactor() {
        let factor = Math.pow(1.01, score);
        for (const modifier of modifiers) {
          if (modifier.type === "slow") {
            factor *= 0.8;
          } else if (modifier.type === "fast") {
            factor *= 1.2;
          }
        }
        return clamp(factor, 0.7, 2.25);
      }
      function currentPaddleFactor() {
        let factor = Math.pow(0.995, score);
        for (const modifier of modifiers) {
          if (modifier.type === "wide") {
            factor *= 1.3;
          } else if (modifier.type === "small") {
            factor *= 0.8;
          }
        }
        return clamp(factor, 0.48, 1.5);
      }
      function spawn(type) {
        const size = type === "box" ? 50 : 39;
        objects.push({
          type,
          x: rand(18, W - size - 18),
          y: -size,
          size,
          vy: clamp(H * 0.13, 105, 145),
          spin: 0
        });
      }
      function burst(
        x,
        y,
        color,
        count = 12
      ) {
        for (let i = 0; i < count; i++) {
          particles.push({
            x,
            y,
            vx: rand(-130, 130),
            vy: rand(-160, 50),
            life: rand(0.3, 0.7),
            color,
            r: rand(2, 5)
          });
        }
      }
      let toastTimer = 0;
      function toast(text) {
        const element = $("#message");
        element.textContent = text;
        element.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          element.classList.remove("show");
        }, 1500);
      }
      function modifier(
        type,
        duration,
        label
      ) {
        modifiers.push({
          type,
          end: elapsed + duration
        });
        toast(label);
      }
      function openBox() {
        const good = Math.random() < 0.6;
        const options = good
          ? [
              () =>
                modifier(
                  "slow",
                  3,
                  "ALÍVIO: BOLA 20% MAIS LENTA"
                ),
              () =>
                modifier(
                  "wide",
                  5,
                  "ALÍVIO: BARRA 30% MAIOR"
                ),
              () => {
                addScore(5);
                toast("BÔNUS: +5 PONTOS");
              }
            ]
          : [
              () =>
                modifier(
                  "fast",
                  4,
                  "TROLL: BOLA 20% MAIS RÁPIDA"
                ),
              () => {
                ball.x = rand(
                  ball.r + 8,
                  W - ball.r - 8
                );
                ball.y = clamp(
                  ball.y,
                  H * 0.18,
                  H * 0.52
                );
                ball.vy = Math.abs(ball.vy);
                toast("TROLL: TELETRANSPORTE");
              },
              () => {
                controlsSign = -1;
                modifier(
                  "invert",
                  3,
                  "TROLL: CONTROLES INVERTIDOS"
                );
              },
              () =>
                modifier(
                  "small",
                  5,
                  "TROLL: BARRA 20% MENOR"
                )
            ];
        options[
          Math.floor(Math.random() * options.length)
        ]();
        tone(
          good ? 720 : 155,
          0.16,
          good ? "sine" : "sawtooth",
          0.05
        );
        haptic(good ? 25 : 55);
      }
      function update(deltaTime) {
        elapsed += deltaTime;
        shake = Math.max(
          0,
          shake - deltaTime * 30
        );
        flash = Math.max(
          0,
          flash - deltaTime
        );
        const hadInvert = modifiers.some(
          (modifier) => modifier.type === "invert"
        );
        modifiers = modifiers.filter(
          (modifier) => modifier.end > elapsed
        );
        if (
          hadInvert &&
          !modifiers.some(
            (modifier) => modifier.type === "invert"
          )
        ) {
          controlsSign = 1;
        }
        paddle.w +=
          (
            paddle.baseW *
              currentPaddleFactor() -
            paddle.w
          ) *
          Math.min(1, deltaTime * 9);
        const desired =
          controlsSign === 1
            ? targetX
            : W - paddle.w - targetX;
        paddle.x +=
          (
            clamp(
              desired,
              7,
              W - paddle.w - 7
            ) -
            paddle.x
          ) *
          Math.min(1, deltaTime * 24);
        if (elapsed >= nextCoin) {
          spawn("coin");
          nextCoin =
            elapsed + rand(6, 10);
        }
        if (elapsed >= nextBox) {
          spawn("box");
          nextBox = elapsed + 15;
        }
        const speedFactor =
          currentSpeedFactor();
        const baseSpeed = clamp(
          H * 0.49,
          390,
          525
        );
        const targetVelocity =
          baseSpeed * speedFactor;
        const length =
          Math.hypot(ball.vx, ball.vy) || 1;
        ball.vx =
          (ball.vx / length) *
          targetVelocity;
        ball.vy =
          (ball.vy / length) *
          targetVelocity;
        const steps = Math.max(
          1,
          Math.ceil(
            targetVelocity *
              deltaTime /
              (ball.r * 0.7)
          )
        );
        const step = deltaTime / steps;
        for (let i = 0; i < steps; i++) {
          ball.x += ball.vx * step;
          ball.y += ball.vy * step;
          if (ball.x - ball.r < 0) {
            ball.x = ball.r;
            ball.vx = Math.abs(ball.vx);
            tone(260, 0.025);
          }
          if (ball.x + ball.r > W) {
            ball.x = W - ball.r;
            ball.vx = -Math.abs(ball.vx);
            tone(260, 0.025);
          }
          if (ball.y - ball.r < 0) {
            ball.y = ball.r;
            ball.vy = Math.abs(ball.vy);
            tone(320, 0.03);
          }
          const touchedPaddle =
            ball.vy > 0 &&
            ball.y + ball.r >= paddle.y &&
            ball.y - ball.r <=
              paddle.y + paddle.h &&
            ball.x >= paddle.x - ball.r &&
            ball.x <=
              paddle.x +
                paddle.w +
                ball.r;
          if (touchedPaddle) {
            ball.y = paddle.y - ball.r;
            const hitPosition = clamp(
              (
                ball.x -
                (
                  paddle.x +
                  paddle.w / 2
                )
              ) /
                (paddle.w / 2),
              -1,
              1
            );
            const angle =
              hitPosition * 1.08;
            ball.vx =
              Math.sin(angle) *
              targetVelocity;
            ball.vy =
              -Math.cos(angle) *
              targetVelocity;
            addScore(1);
            burst(
              ball.x,
              paddle.y,
              "#ffffff",
              9
            );
            tone(
              490 +
                Math.min(score, 50) * 7,
              0.055,
              "sine",
              0.045
            );
            haptic(11);
          }
        }
        ball.trail.push({
          x: ball.x,
          y: ball.y,
          life: 1
        });
        if (ball.trail.length > 12) {
          ball.trail.shift();
        }
        ball.trail.forEach((point) => {
          point.life -= deltaTime * 4;
        });
        for (
          let index = objects.length - 1;
          index >= 0;
          index--
        ) {
          const object = objects[index];
          object.y +=
            object.vy * deltaTime;
          object.spin += deltaTime * 2;
          const touchedObject =
            object.y + object.size >=
              paddle.y &&
            object.y <=
              paddle.y + paddle.h &&
            object.x + object.size >=
              paddle.x &&
            object.x <=
              paddle.x + paddle.w;
          if (touchedObject) {
            objects.splice(index, 1);
            burst(
              object.x +
                object.size / 2,
              object.y +
                object.size / 2,
              object.type === "coin"
                ? "#ffd84a"
                : "#50dd79",
              18
            );
            if (object.type === "coin") {
              coins++;
              storage.set(
                "coins",
                coins
              );
              updateHUD();
              tone(
                880,
                0.11,
                "sine",
                0.05
              );
              toast("+1 MOEDA");
              haptic(18);
            } else {
              openBox();
            }
          } else if (
            object.y >
            H + object.size
          ) {
            objects.splice(index, 1);
          }
        }
        for (
          let index = particles.length - 1;
          index >= 0;
          index--
        ) {
          const particle =
            particles[index];
          particle.x +=
            particle.vx * deltaTime;
          particle.y +=
            particle.vy * deltaTime;
          particle.vy +=
            260 * deltaTime;
          particle.life -= deltaTime;
          if (particle.life <= 0) {
            particles.splice(index, 1);
          }
        }
        if (ball.y - ball.r > H) {
          endGame();
        }
      }
      function endGame() {
        mode = "over";
        cancelAnimationFrame(raf);
        shake = 8;
        haptic(120);
        tone(
          105,
          0.28,
          "sawtooth",
          0.06
        );
        if (score > best) {
          best = score;
          storage.set(
            "best",
            best
          );
        }
        $("#finalScore").textContent =
          score;
        $("#bestScore").textContent =
          best;
        $("#rank").textContent =
          "Você chegou ao " +
          rankNames[paletteIndex()];
        setTimeout(() => {
          show("#gameOver");
        }, 220);
      }
      function roundRect(
        context,
        x,
        y,
        width,
        height,
        radius
      ) {
        context.beginPath();
        context.roundRect(
          x,
          y,
          width,
          height,
          radius
        );
      }
      function drawBackground() {
        const palette =
          palettes[paletteIndex()];
        const gradient =
          ctx.createLinearGradient(
            0,
            0,
            W,
            H
          );
        gradient.addColorStop(
          0,
          palette[0]
        );
        gradient.addColorStop(
          1,
          palette[1]
        );
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, W, H);
        ctx.globalAlpha = 0.055;
        for (let i = 0; i < 3; i++) {
          ctx.fillStyle = "#fff";
          ctx.beginPath();
          ctx.arc(
            W * (0.15 + i * 0.42),
            H * (0.28 + i * 0.24),
            W * (0.48 - i * 0.07),
            0,
            Math.PI * 2
          );
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        if (flash > 0) {
          ctx.fillStyle =
            `rgba(255,255,255,${flash * 0.4})`;
          ctx.fillRect(0, 0, W, H);
        }
      }
      function drawBall() {
        const skin = activeSkin();
        ball.trail.forEach(
          (point, index) => {
            ctx.globalAlpha =
              Math.max(0, point.life) *
              0.08;
            ctx.fillStyle =
              skin.color;
            ctx.beginPath();
            ctx.arc(
              point.x,
              point.y,
              ball.r *
                (
                  index /
                  ball.trail.length
                ),
              0,
              Math.PI * 2
            );
            ctx.fill();
          }
        );
        ctx.globalAlpha = 1;
        if (
          ["fire", "ice", "angry"].includes(
            skin.id
          )
        ) {
          ctx.font =
            `${ball.r * 2}px sans-serif`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(
            skin.icon,
            ball.x,
            ball.y + 1
          );
        } else {
          const gradient =
            ctx.createRadialGradient(
              ball.x -
                ball.r * 0.35,
              ball.y -
                ball.r * 0.45,
              2,
              ball.x,
              ball.y,
              ball.r * 1.1
            );
          gradient.addColorStop(
            0,
            skin.id === "matte"
              ? "#323237"
              : "#6b7280"
          );
          gradient.addColorStop(
            0.35,
            skin.color
          );
          gradient.addColorStop(
            1,
            "#000"
          );
          ctx.fillStyle = gradient;
          ctx.shadowColor =
            "rgba(0,0,0,.35)";
          ctx.shadowBlur = 15;
          ctx.beginPath();
          ctx.arc(
            ball.x,
            ball.y,
            ball.r,
            0,
            Math.PI * 2
          );
          ctx.fill();
          ctx.shadowBlur = 0;
          if (skin.id === "eight") {
            ctx.fillStyle = "#fff";
            ctx.beginPath();
            ctx.arc(
              ball.x,
              ball.y,
              ball.r * 0.45,
              0,
              Math.PI * 2
            );
            ctx.fill();
            ctx.fillStyle = "#111";
            ctx.font =
              `bold ${ball.r * 0.62}px sans-serif`;
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(
              "8",
              ball.x,
              ball.y
            );
          }
        }
      }
      function drawPaddle() {
        ctx.shadowColor =
          "rgba(0,0,0,.25)";
        ctx.shadowBlur = 16;
        ctx.shadowOffsetY = 8;
        const gradient =
          ctx.createLinearGradient(
            0,
            paddle.y,
            0,
            paddle.y + paddle.h
          );
        gradient.addColorStop(
          0,
          "#fff"
        );
        gradient.addColorStop(
          1,
          "#dce5f4"
        );
        ctx.fillStyle = gradient;
        roundRect(
          ctx,
          paddle.x,
          paddle.y,
          paddle.w,
          paddle.h,
          paddle.h / 2
        );
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.shadowOffsetY = 0;
      }
      function drawObjects() {
        for (const object of objects) {
          const centerX =
            object.x +
            object.size / 2;
          const centerY =
            object.y +
            object.size / 2;
          ctx.save();
          ctx.translate(
            centerX,
            centerY
          );
          ctx.rotate(
            object.type === "coin"
              ? object.spin
              : Math.sin(object.spin) *
                  0.08
          );
          ctx.translate(
            -centerX,
            -centerY
          );
          ctx.shadowColor =
            "rgba(0,0,0,.22)";
          ctx.shadowBlur = 14;
          ctx.shadowOffsetY = 7;
          if (object.type === "coin") {
            const gradient =
              ctx.createRadialGradient(
                centerX -
                  object.size * 0.2,
                centerY -
                  object.size * 0.25,
                2,
                centerX,
                centerY,
                object.size * 0.55
              );
            gradient.addColorStop(
              0,
              "#fff59b"
            );
            gradient.addColorStop(
              0.36,
              "#ffd83d"
            );
            gradient.addColorStop(
              1,
              "#ed9d08"
            );
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(
              centerX,
              centerY,
              object.size * 0.48,
              0,
              Math.PI * 2
            );
            ctx.fill();
            ctx.strokeStyle =
              "rgba(255,255,255,.45)";
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.fillStyle =
              "#fff3a7";
            ctx.font =
              `900 ${object.size * 0.52}px sans-serif`;
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(
              "$",
              centerX,
              centerY + 1
            );
          } else {
            const gradient =
              ctx.createLinearGradient(
                object.x,
                object.y,
                object.x +
                  object.size,
                object.y +
                  object.size
              );
            gradient.addColorStop(
              0,
              "#62e678"
            );
            gradient.addColorStop(
              1,
              "#159447"
            );
            ctx.fillStyle = gradient;
            roundRect(
              ctx,
              object.x,
              object.y,
              object.size,
              object.size,
              11
            );
            ctx.fill();
            ctx.strokeStyle =
              "#08723a";
            ctx.lineWidth = 3;
            ctx.stroke();
            ctx.fillStyle = "#fff";
            ctx.font =
              `900 ${object.size * 0.66}px sans-serif`;
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(
              "?",
              centerX,
              centerY + 2
            );
          }
          ctx.restore();
        }
      }
      function render() {
        ctx.save();
        if (shake > 0) {
          ctx.translate(
            rand(-shake, shake),
            rand(-shake, shake)
          );
        }
        drawBackground();
        drawObjects();
        for (const particle of particles) {
          ctx.globalAlpha = clamp(
            particle.life / 0.55,
            0,
            1
          );
          ctx.fillStyle =
            particle.color;
          ctx.beginPath();
          ctx.arc(
            particle.x,
            particle.y,
            particle.r,
            0,
            Math.PI * 2
          );
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        drawBall();
        drawPaddle();
        ctx.restore();
      }
      function loop(now) {
        if (mode !== "playing") return;
        const deltaTime = Math.min(
          0.033,
          (now - last) / 1000 || 0
        );
        last = now;
        update(deltaTime);
        render();
        if (mode === "playing") {
          raf =
            requestAnimationFrame(loop);
        }
      }
      function setTarget(clientX) {
        if (!dragging) {
          pointerX = clientX;
          dragging = true;
          return;
        }
        const delta =
          (clientX - pointerX) * 1.2;
        pointerX = clientX;
        targetX = clamp(
          targetX + delta,
          7,
          W - paddle.w - 7
        );
      }
      canvas.addEventListener(
        "pointerdown",
        (event) => {
          canvas.setPointerCapture?.(
            event.pointerId
          );
          dragging = false;
          setTarget(event.clientX);
        }
      );
      canvas.addEventListener(
        "pointermove",
        (event) => {
          if (
            event.buttons ||
            event.pointerType === "touch"
          ) {
            setTarget(event.clientX);
          }
        }
      );
      canvas.addEventListener(
        "pointerup",
        () => {
          dragging = false;
        }
      );
      canvas.addEventListener(
        "pointercancel",
        () => {
          dragging = false;
        }
      );
      $("#play").onclick =
        startGame;
      $("#again").onclick =
        startGame;
      $("#home").onclick = () => {
        mode = "menu";
        show("#start");
        render();
      };
      $("#pause").onclick = () => {
        if (mode === "playing") {
          mode = "paused";
          cancelAnimationFrame(raf);
          show("#paused");
        }
      };
      $("#resume").onclick = () => {
        mode = "playing";
        hideAll();
        last = performance.now();
        raf =
          requestAnimationFrame(loop);
      };
      $("#quit").onclick = () => {
        mode = "menu";
        show("#start");
        render();
      };
      $("#sound").onclick = () => {
        soundOn = !soundOn;
        storage.set(
          "sound",
          soundOn
        );
        $("#sound").textContent =
          "SOM: " +
          (soundOn ? "ON" : "OFF");
      };
      $("#sound").textContent =
        "SOM: " +
        (soundOn ? "ON" : "OFF");
      function renderShop() {
        $("#shopBalance").textContent =
          "● " +
          coins +
          " moedas";
        const grid = $("#shopGrid");
        grid.innerHTML = "";
        for (const skin of skins) {
          const isOwned =
            owned.includes(skin.id);
          const locked =
            skin.id === "matte" &&
            !isOwned;
          const button =
            document.createElement(
              "button"
            );
          button.className =
            "item" +
            (
              selected === skin.id
                ? " selected"
                : ""
            );
          button.innerHTML = `
            <span class="preview">${skin.icon}</span>
            <strong>${skin.name}</strong>
            <small>
              ${
                locked
                  ? "Chegue a 50 pontos"
                  : isOwned
                  ? "Selecionada / usar"
                  : skin.price +
                    " moedas"
              }
            </small>
          `;
          button.onclick = () => {
            if (locked) {
              toast(
                "CHEGUE A 50 PONTOS"
              );
              return;
            }
            if (!isOwned) {
              if (
                coins < skin.price
              ) {
                toast(
                  "MOEDAS INSUFICIENTES"
                );
                return;
              }
              coins -= skin.price;
              owned.push(skin.id);
              storage.set(
                "coins",
                coins
              );
              storage.set(
                "owned",
                owned
              );
              updateHUD();
            }
            selected = skin.id;
            storage.set(
              "skin",
              selected
            );
            renderShop();
            render();
            tone(660, 0.08);
          };
          grid.appendChild(button);
        }
      }
      document
        .querySelectorAll(
          ".openShop"
        )
        .forEach((button) => {
          button.onclick = () => {
            $("#shopPanel").classList.remove(
              "hidden"
            );
            renderShop();
          };
        });
      $("#closeShop").onclick = () => {
        $("#shopPanel").classList.add(
          "hidden"
        );
      };
      addEventListener(
        "resize",
        () => {
          resize();
          render();
        },
        {
          passive: true
        }
      );
      addEventListener(
        "visibilitychange",
        () => {
          if (
            document.hidden &&
            mode === "playing"
          ) {
            $("#pause").click();
          }
        }
      );
      resize();
      reset();
      render();
    })();
  </script>
</body>
</html>